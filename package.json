{
  "name": "watchface",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . && npm run lint:styles",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:builds": "node services/watchface/smoke.mjs",
    "format": "prettier --write .",
    "project:export": "tsc -p services/watchface/tsconfig.json && node .watchface-service/services/watchface/export-project.js",
    "lint:styles": "node scripts/lint-styles.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
